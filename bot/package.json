{
  "name": "warzone-rating-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord bot frontend for the Warzone Rebirth rating engine Worker",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "deploy-commands:prod": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
