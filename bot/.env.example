# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# Guild to register commands in (instant updates). Leave empty to register globally (can take ~1h to propagate).
GUILD_ID=your-guild-id

# Cloudflare Worker rating engine
WORKER_API_BASE=https://warzone-rating-engine.your-subdomain.workers.dev
API_TOKEN=same-value-as-wrangler-secret-API_TOKEN

# Optional: only members with this role (or Manage Server) may submit matches. Leave empty to allow everyone.
SUBMITTER_ROLE_ID=
